{
    "Description": "JuiceFS plugin for Docker",
    "Documentation": "https://github.com/juicedata/docker-volume-juicefs",
    "Entrypoint": [
        "/docker-volume-juicefs"
    ],
    "Env": [
        {
            "Name": "DEBUG",
            "Settable": [
                "value"
            ],
            "Value": "0"
        }
    ],
    "Interface": {
        "Socket": "jfs.sock",
        "Types": [
            "docker.volumedriver/1.0"
        ]
    },
    "Linux": {
        "Capabilities": [
            "CAP_SYS_ADMIN"
        ],
        "Devices": [
            {
                "Path": "/dev/fuse"
            }
        ]
    },
    "Mounts": [
        {
            "Description": "Plugin state directory",
            "Destination": "/jfs/state",
            "Name": "state",
            "Options": ["rbind"],
            "Settable": ["source"],
            "Source": "/var/lib/docker/plugins/",
            "Type": "bind"
        },
        {
            "Description": "JuiceFS cache directory",
            "Destination": "/var/jfsCache",
            "Name": "cache",
            "Options": ["rbind", "rw"],
            "Settable": ["source"],
            "Source": "/var/lib/juicefs-cache",
            "Type": "bind"
        }
    ],
    "Network": {
        "Type": "host"
    },
    "PropagatedMount": "/jfs/volumes"
}
